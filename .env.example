HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ===== LLM 投资顾问配置 =====
# 未配置 LLM_API_KEY 时，投资顾问模块不可用（其他功能不受影响）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=8000
# 留空表示不发送 temperature。部分模型（如经 Bedrock 的 claude-opus-5）已废弃该参数。
# 若填了不被支持的值，程序会自动去掉该参数重试。
LLM_TEMPERATURE=

# 知识库目录（存放个人投资笔记的 markdown 文件，相对项目根目录）
KNOWLEDGE_DIR=knowledge
